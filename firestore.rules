rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function adminDocExists() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Missing `role` defaults to 'admin' on purpose. Before the viewer role
    // existed, an `admins/{email}` doc was membership alone and every entry was
    // a full organizer — so a doc written under the old shape must keep meaning
    // exactly what it meant then. Reading `.data.role` directly returned null
    // for those, which failed BOTH isAdmin() and isViewer() and locked the
    // organizer out of the dashboard entirely. New entries should still be
    // written with an explicit role; this is the compatibility floor, not the
    // documented way to add someone.
    function adminRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.token.email))
        .data.get('role', 'admin');
    }

    // Full organizer: can manage shifts, remove volunteers, stage awards.
    function isAdmin() {
      return signedIn() && adminDocExists() && adminRole() == 'admin';
    }

    // Read-only: sees the volunteer roster (signups) but cannot write.
    function isViewer() {
      return signedIn() && adminDocExists() && adminRole() == 'viewer';
    }

    // Public event + shift info (counts only, never PII)
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();

      match /shifts/{shiftId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Show-day award winners. Organizers stage the judges' results here
      // before the 3:00pm ceremony, so a staged row must not leak early:
      // the public may only read rows already announced from the stage.
      // A query without `where('announced', '==', true)` is rejected for
      // everyone but an organizer — that filter is what makes the read
      // provably safe, so the public board must always include it.
      match /awards/{awardId} {
        allow read: if isAdmin() || resource.data.announced == true;
        allow write: if isAdmin();
      }
    }

    // Volunteer PII — never publicly readable. Volunteers write via Cloud
    // Functions (Admin SDK bypasses rules); organizers manage via dashboard.
    match /signups/{signupId} {
      allow read: if isAdmin() || isViewer();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // Allowlist managed in the Firebase console only.
    match /admins/{email} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == email;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
