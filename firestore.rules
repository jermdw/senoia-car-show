rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Public event + shift info (counts only, never PII)
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();

      match /shifts/{shiftId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Show-day award winners. Organizers stage the judges' results here
      // before the 3:00pm ceremony, so a staged row must not leak early:
      // the public may only read rows already announced from the stage.
      // A query without `where('announced', '==', true)` is rejected for
      // everyone but an organizer — that filter is what makes the read
      // provably safe, so the public board must always include it.
      match /awards/{awardId} {
        allow read: if isAdmin() || resource.data.announced == true;
        allow write: if isAdmin();
      }
    }

    // Volunteer PII — never publicly readable. Volunteers write via Cloud
    // Functions (Admin SDK bypasses rules); organizers manage via dashboard.
    match /signups/{signupId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // Allowlist managed in the Firebase console only.
    match /admins/{email} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == email;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
